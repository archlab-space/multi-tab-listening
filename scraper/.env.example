# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=discord_monitor
DB_PASSWORD=your_password_here
DB_PORT=5432

# Discord Channels (comma-separated list of channel IDs)
DISCORD_CHANNELS=123456789012345678,987654321098765432

# Optional: Path to save Discord session (to avoid re-login)
STORAGE_STATE_PATH=./discord-session.json

# Filtering Configuration
ENABLE_FILTERING=true
MIN_MESSAGE_LENGTH=15

# Optional: Custom trivial phrases (comma-separated)
CUSTOM_TRIVIAL_PHRASES=brb,afk,gtg

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info